            <!-- Feedback: polled at startup and every 5 seconds. SplycedBoard answers from
                 state it already holds, so polling never waits on the Apple TV. -->
            <action name="QueryStatus">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character" http_request_type="GET">api/appletv/status</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character"><![CDATA[?ip=]]></parameter>
                            <parameter parameter_data_type="character" state_variable="AppleTVAddress"/>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="AppleTVStatus">
                                <constant type="character">200</constant>
                                <root_object name="none" matches_required="at_least_one" format="json">
                                    <values path="/none/power" matches_required="at_least_one">
                                        <update state="AppleTVPower" type="string"></update>
                                    </values>
                                    <values path="/none/playing" matches_required="none">
                                        <update state="AppleTVPlaying" type="boolean"></update>
                                    </values>
                                    <values path="/none/connected" matches_required="none">
                                        <update state="AppleTVConnected" type="boolean"></update>
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
                <execute_on_schedule period_ms="0"/>
                <execute_on_schedule period_ms="5000"/>
            </action>
            <!-- Tells SplycedBoard which version of this profile Savant is running, so its dashboard
                 can warn when the profile is out of date. Keep version= equal to rpm_xml_version. -->
            <action name="ReportProfileVersion">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character" http_request_type="GET">api/hub/profile-report</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character"><![CDATA[?integration=appletv&version=1.2&device=]]></parameter>
                            <parameter parameter_data_type="character" state_variable="AppleTVAddress"/>
                        </parameter_list>
                    </command>
                </command_interface>
                <execute_on_schedule period_ms="0"/>
                <execute_on_schedule period_ms="60000"/>
            </action>
        </custom_component_actions>

#!/bin/bash
# Set a new password for the SplycedBoard dashboard, or remove it: for when it's forgotten.
# Whoever can run this is at the Mac (or logged in to it), so it doesn't ask for the old one.
# The service takes the change at once, and every browser has to log in again.
#
#   scripts/reset-password              asks for the new password
#   scripts/reset-password --remove     no password: anyone on the network can use the dashboard
#   scripts/reset-password --headless   asks in the terminal (automatic over SSH)
set -u
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
REMOVE=0
for arg in "$@"; do
  case "$arg" in
    --headless) SB_HEADLESS=1 ;;
    --remove) REMOVE=1 ;;
    *) echo "usage: scripts/reset-password [--remove] [--headless]"; exit 2 ;;
  esac
done
detect_gui
find_runtime || { fail "Needs Bun or Node.js 18+ — run ./install first."; exit 1; }
[ -f "$INSTALL_DIR/src/cli.js" ] || { fail "SplycedBoard isn't installed in $INSTALL_DIR"; exit 1; }
cli() { SPLYCEDBOARD_HOME="$INSTALL_DIR" "$RUNTIME" "$INSTALL_DIR/src/cli.js" "$@"; }

if [ "$REMOVE" = 1 ]; then
  ask_yes "Remove the SplycedBoard dashboard password?

Anyone on your network will be able to use the dashboard." "Remove Password" || { echo "Cancelled."; exit 0; }
  cli clear-password || { fail "Couldn't remove the password"; exit 1; }
  ok "Password removed: anyone on the network can use the dashboard"
  exit 0
fi

PW="$(new_password "New password for the SplycedBoard dashboard.

Other devices will need it to open the dashboard, and every browser logged in now has to log in again. This Mac itself never needs it." "Cancel")"
[ -n "$PW" ] || { echo "Cancelled: the password is unchanged."; exit 0; }
printf '%s' "$PW" | cli set-password || { fail "Couldn't save the password"; exit 1; }
PW=""
ok "Password changed. Browsers have to log in again."
notify "Dashboard password changed"

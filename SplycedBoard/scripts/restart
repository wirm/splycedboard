#!/bin/bash
# Restart the SplycedBoard background service.
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
[ -f "$PLIST" ] || { fail "SplycedBoard isn't installed — run ./install first."; exit 1; }
if svc_loaded "$LABEL"; then launchctl kickstart -k "$GUI_DOMAIN/$LABEL"; else svc_start; fi
wait_healthy 20 && ok "Running (pid $(svc_pid)) — http://localhost:$WEB_PORT" || { fail "Didn't come up — see $LOG_DIR/splycedboard.log"; exit 1; }
